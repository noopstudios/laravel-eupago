{
    "name": "noopstudios/laravel-eupago",
    "description": "Multibanco references and MB WAY payments through the EuPago API for Laravel, with an optional Filament plugin.",
    "keywords": ["laravel", "eupago", "multibanco", "mbway", "payments", "filament"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "filament/filament": "^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0"
    },
    "suggest": {
        "filament/filament": "Required for the EuPago panel plugin (^5.0): payment attempts and webhook events."
    },
    "autoload": {
        "psr-4": {
            "Noop\\Eupago\\": "src/",
            "Noop\\Eupago\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noop\\Eupago\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noop\\Eupago\\EupagoServiceProvider"
            ],
            "aliases": {
                "Eupago": "Noop\\Eupago\\Facades\\Eupago"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
