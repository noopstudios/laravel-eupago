# Credentials for the sandbox suite (tests/Integration/SandboxTest.php):
#   EUPAGO_SANDBOX_ENV=/path/to/.env.sandbox vendor/bin/pest --group=sandbox
# Copy to .env.sandbox (git-ignored) or point EUPAGO_SANDBOX_ENV at a file outside the repository.
# The suite always talks to sandbox.eupago.pt, whatever EUPAGO_SANDBOX says, and every run
# creates one real Multibanco reference and one real MB WAY request in that sandbox.

EUPAGO_API_KEY=

# A phone number for the MB WAY request (9 digits). Without it the MB WAY test is skipped.
EUPAGO_SANDBOX_PHONE=
